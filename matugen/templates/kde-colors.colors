# Upstream's template reads the .dark variant of each colour here, on the
# theory that Complementary is the inverted palette. With theme.engine
# "native" that is a no-op, since the engine emits identical light/default/
# dark values, so this uses .default to keep the file readable. Switching
# engine to matugen, which does produce different variants, is the case where
# these should go back to .dark.
[Colors:Complementary]
BackgroundAlternate={{colors.surface.default.red}},{{colors.surface.default.green}},{{colors.surface.default.blue}}
BackgroundNormal={{colors.surface.default.red}},{{colors.surface.default.green}},{{colors.surface.default.blue}}
DecorationFocus={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
