# Every foreground role here is on_primary_container, including the ones that
# normally carry meaning of their own. Upstream keeps error for
# ForegroundNegative, which is the more correct scheme but not a colour the
# generator can promise is readable on a wallpaper-derived primary_container:
# both come from the same image, and nothing constrains their contrast. A
# selected row with unreadable error text is worse than one where error text
# is merely not red, so the whole group is pinned to the one colour the
# palette does guarantee against this background. Same reasoning in Tooltip
# below, against inverse_surface.
[Colors:Selection]
BackgroundAlternate={{colors.primary_container.default.red}},{{colors.primary_container.default.green}},{{colors.primary_container.default.blue}}
BackgroundNormal={{colors.primary_container.default.red}},{{colors.primary_container.default.green}},{{colors.primary_container.default.blue}}
