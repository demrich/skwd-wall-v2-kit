#!/usr/bin/bash
# Re-apply the theme after skwd-walld's startup restore, at login.
#
# skwd-bazzite's skwd-walld.service starts the daemon. This runs after it, for
# two skwd-wall v2 gaps (seen from beta.11 through beta.18), both candidates
# for an upstream fix:
#
#  1. walld's startup restore re-applies the wallpaper but runs no theme
#     steps at all (no "theme apply", no integrations, no post-processing),
#     so a fresh login comes up with the previous session's colours.
#  2. "skwd-helm retheme" answers "no current wallpaper to retheme" after a
#     restore -- the restore path never populates the in-memory current
#     wallpaper that retheme reads. So the kick has to be an explicit apply
#     of the path that "skwd-helm current" reports.
#
# Every container entry is bounded (see skwd-bazzite's box() for the cold
# container race that makes that necessary); the container is already warm by
# the time this runs, because skwd-walld.service has entered it.
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/skwd-bazzite/config"
BOX="${SKWD_WALL_V2_BOX:-$(sed -n 's/^box=//p' "$CONF" 2>/dev/null | head -1)}"
BOX="${BOX:-skwd-wall-v2-fedora}"
DISTROBOX="$(command -v distrobox || echo /usr/bin/distrobox)"
box() { timeout 20 "$DISTROBOX" enter -T -n "$BOX" -- "$@"; }

CUR=""
for _ in $(seq 1 30); do
    CUR="$(box /usr/bin/skwd-helm current --json 2>/dev/null \
        | jq -r '[.outputs[]? | .current // empty] | map(select(length > 0)) | .[0] // empty' 2>/dev/null)"
    [ -n "$CUR" ] && break
    sleep 1
done

[ -n "$CUR" ] || { echo "no wallpaper to restore" >&2; exit 0; }

# Gap 2: apply, not retheme. This is what runs integrations + post-processing.
#
# One retry: the Plasma wallpaper plugin can answer SIGPIPE if the containment
# is still settling this early in the session. A login unit that goes "failed"
# over a transient here is worse than a warning -- the theme is re-applied on
# the next wallpaper change anyway.
if ! box /usr/bin/skwd-helm apply "$CUR"; then
    sleep 3
    box /usr/bin/skwd-helm apply "$CUR" || \
        echo "skwd-wall-v2-session: restore apply failed for $CUR" >&2
fi
exit 0
